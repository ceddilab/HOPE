<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nearest Route - D.D.C.A</title>
  <link rel="stylesheet" href="/css/routes.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body>

  <nav class="navbar">
    <div class="nav-container">
      <div class="brand">D.D.C.A</div>
      <div class="nav-links">
        <a href="/home">Home</a>
        <a href="/AboutUs">About Us</a>
        <% if (!user) { %>
          <a href="/login">Login</a>
        <% } else { %>
          <a href="/logout">Logout</a>
        <% } %>
      </div>
    </div>
  </nav>

  <header class="hero">
    <div class="hero-content">
      <h1>Nearest Route</h1>
      <p>Find the closest depot from your current location in real time.</p>
    </div>
  </header>

  <section class="scroll-section visible">
    <div class="content-box">
      <h2>How It Works</h2>
      <p>
        Allow location access, then we compare your position against known depot
        points and surface the closest ones with driving directions.
      </p>
      <ul>
        <li>Uses your live GPS position</li>
        <li>Ranks depots by straight-line distance</li>
        <li>Opens Google Maps for car directions</li>
      </ul>
    </div>
  </section>

  <section class="scroll-section visible">
    <div class="content-box">
      <h2>Your Location Map</h2>
      <div class="route-controls">
        <button type="button" id="find-nearest" disabled>Find Nearest</button>
      </div>
      <p id="status-text">Waiting for map setup.</p>
      <div id="map"></div>
      <ul id="nearest-list"></ul>
    </div>
  </section>

  <footer>
    <p>© 2025 D.D.C.A All rights reserved.</p>
  </footer>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/js/routes.js"></script>
</body>
</html>
