<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ECHO - Area Context - D.D.C.A</title>
  <link rel="stylesheet" href="/css/area-info.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body>

  <nav class="navbar">
    <div class="nav-container">
      <div class="brand">D.D.C.A</div>
      <div class="nav-links">
        <a href="/home">Home</a>
        <a href="/AboutUs">About Us</a>
        <% if (!user) { %>
          <a href="/login">Login</a>
        <% } else { %>
          <a href="/logout">Logout</a>
        <% } %>
      </div>
    </div>
  </nav>

  <header class="hero">
    <div class="hero-content">
      <h1>ECHO</h1>
      <p>See hazards near you, open area details, and get quick response guidance.</p>
    </div>
  </header>

  <section class="scroll-section visible">
    <div class="content-box">
      <h2>How It Works</h2>
      <p>
        Default California hazard points load automatically. Upload your own
        .json or .csv with latitude and longitude if you want a custom set.
      </p>
      <ul>
        <li>Uses your live GPS position</li>
        <li>Click a hazard for context and tips</li>
        <li>Jump to nearest-route (NET) when you need a depot</li>
      </ul>
    </div>
  </section>

  <section class="scroll-section visible">
    <div class="content-box">
      <h2>Area Map and Guidance</h2>
      <div class="echo-controls">
        <input type="file" id="file-upload" accept=".json, .csv" />
      </div>
      <p id="status-text">Loading map...</p>
      <div class="echo-layout">
        <div id="map"></div>
        <aside class="detail-panel" id="detail-panel">
          <p class="placeholder">Click a hazard on the map to see details and response tips.</p>
        </aside>
      </div>
    </div>
  </section>

  <footer>
    <p>© 2025 D.D.C.A All rights reserved.</p>
  </footer>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/papaparse@5.3.2/papaparse.min.js"></script>
  <script src="/js/area-info.js"></script>
</body>
</html>
