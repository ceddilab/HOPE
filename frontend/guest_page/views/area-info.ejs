<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ECHO - Area Context - D.D.C.A</title>
  <link rel="stylesheet" href="/css/area-info.css" />
</head>
<body>

  <nav class="navbar">
    <div class="nav-container">
      <div class="brand">D.D.C.A</div>
      <div class="nav-links">
        <a href="/home">Home</a>
        <a href="/AboutUs">About Us</a>
        <% if (!user) { %>
          <a href="/login">Login</a>
        <% } else { %>
          <a href="/logout">Logout</a>
        <% } %>
      </div>
    </div>
  </nav>

  <header class="hero">
    <div class="hero-content">
      <h1>ECHO</h1>
      <p>See hazards near you, open area details, and get quick response guidance.</p>
    </div>
  </header>

  <section class="scroll-section visible">
    <div class="content-box">
      <h2>How It Works</h2>
      <p>
        Load area hazard points, click one for context, then jump to routing when
        you need a depot.
      </p>
      <ul>
        <li>Uses your live GPS position</li>
        <li>Click a hazard for context and tips</li>
        <li>Jump to nearest-route (NET) when you need a depot</li>
      </ul>
    </div>
  </section>

  <section class="scroll-section visible">
    <div class="content-box">
      <h2>Area Map and Guidance</h2>
      <p id="status-text">Map setup coming next.</p>
      <div id="map"></div>
    </div>
  </section>

  <footer>
    <p>© 2025 D.D.C.A All rights reserved.</p>
  </footer>

</body>
</html>
