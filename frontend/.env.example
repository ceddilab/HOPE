# Reserved for future frontend runtime/build configuration.
# The Express frontend reads these values at server start and exposes
# BACKEND_URL to browser-side scripts through /config.js.
PORT=3000
BACKEND_URL=http://localhost:5000

# 🔐 Must be IDENTICAL to the backend's JWT_SECRET. The frontend verifies the
# session cookie locally with this secret to render the logged-in/out navbar.
JWT_SECRET=replace_with_a_strong_secret

# Set to "production" to send the session cookie only over HTTPS.
NODE_ENV=development
